{
  "manifest_version": 3,
  "name": "Session Saver",
  "version": "2.15.1",
  "description": "Save, organize, restore, import and export browser sessions \u2014 with per-tab history navigation, workspaces and an optional new tab homepage \u2014 with maximum flexibility.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Session Saver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  },
  "options_page": "manager.html",
  "chrome_url_overrides": {
    "newtab": "homepage.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/navButtons.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "search",
    "favicon",
    "system.display",
    "system.cpu",
    "system.memory",
    "system.storage"
  ],
  "incognito": "spanning",
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "description": "Open the Session Saver quick access popup"
    },
    "save-current-session": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current session"
    },
    "restore-last-session": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Restore the most recently saved session"
    },
    "nav-back": {
      "suggested_key": {
        "default": "Alt+Shift+Left"
      },
      "description": "Session Saver: go back in this tab's restored history"
    },
    "nav-forward": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "Session Saver: go forward in this tab's restored history"
    }
  }
}
